# מפתח Claude (console.anthropic.com → API Keys). בלי מפתח: מצב מילות מפתח בלבד.
ANTHROPIC_API_KEY=

# בוט טלגרם: ב-@BotFather שלח /newbot והדבק כאן את הטוקן.
TELEGRAM_BOT_TOKEN=
